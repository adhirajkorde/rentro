# Backend Environment Variables - Rentora
# =======================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/rentora

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRES_IN=30d
JWT_RESET_SECRET=your-jwt-reset-secret-change-in-production
JWT_COOKIE_EXPIRES_IN=30d

# Server Configuration
PORT=4000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (for media storage - configure when ready)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # max requests per window